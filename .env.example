# Backblaze B2
B2_KEY_ID=your_key_id
B2_APP_KEY=your_app_key
B2_BUCKET_NAME=your_bucket_name

# Admin authentication
ADMIN_PASSWORD=your_secure_password
ADMIN_SESSION_SECRET=random_long_secret_string

# Student authentication (requires DATABASE_URL)
STUDENT_AUTH_REQUIRED=false
STUDENT_SESSION_SECRET=another_random_long_secret_string

# Local Test User / Guest mode
LOCAL_TEST_USER_ENABLED=false
# On Render/production, also set LOCAL_TEST_USER_ALLOW_PRODUCTION=true to show "Continue as Guest"
# LOCAL_TEST_USER_ALLOW_PRODUCTION=false
#
# Render blueprint (render.yaml) presets for production deploys:
#   LOCAL_TEST_USER_ENABLED=true
#   LOCAL_TEST_USER_ALLOW_PRODUCTION=true
#   PUBLIC_PLAYGROUND_ENABLED=true

# Welcome-screen sample projects (requires DATABASE_URL + B2 for combined ZIP bundles)
PUBLIC_PLAYGROUND_ENABLED=false
# Optional: dedicated key for encrypting retrievable student passwords (defaults to STUDENT_SESSION_SECRET)
# STUDENT_PASSWORD_ENCRYPTION_SECRET=another_random_long_secret_string

# PostgreSQL (Render managed DB — set automatically on Render via DATABASE_URL)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_SSL=false

# Optional Stripe billing
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_CLASS=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_ALLOW_STUDENT_UPGRADES=false

# Optional: skip automatic CORS updates on each server start (set true on Render after first deploy)
# B2_SKIP_CORS_UPDATE=true

# Optional: if bucket exists but name lookup fails, set bucket ID from B2 console
# B2_BUCKET_ID=

# Public bucket for shared common assets (direct Backblaze URLs + CORS)
# Created automatically as {B2_BUCKET_NAME}-public if omitted
# B2_PUBLIC_BUCKET_NAME=hotspot-vr-public
# B2_PUBLIC_BUCKET_ID=

# Optional: explicit public URL when behind Render/proxy (student project hosting only)
# SERVER_BASE_URL=https://your-app.onrender.com

# Admin Usage & Infrastructure dashboard (Render metrics)
# Create an API key: Render Dashboard → Account Settings → API Keys
# RENDER_API_KEY=rnd_...
# RENDER_SERVICE_ID is usually auto-set on Render; set it locally to your srv-... id
# RENDER_SERVICE_ID=srv-xxxxx
# Optional: override snapshot cadence (default 6 hours). Set USAGE_SNAPSHOT_DISABLED=true to skip.
# USAGE_SNAPSHOT_INTERVAL_MS=21600000
# USAGE_SNAPSHOT_DISABLED=false
# Optional: B2 storage ceiling for Usage dashboard max-line (set one)
# USAGE_B2_MAX_GB=10
# USAGE_B2_MAX_BYTES=10737418240
# Soft ceiling for daily B2 download bandwidth on the Usage dashboard (GMT day).
# Admin can also set this in Usage → B2 soft caps (stored in app_settings).
# USAGE_B2_DOWNLOAD_MAX_GB=200
# USAGE_B2_DOWNLOAD_MAX_BYTES=

# Server port (Render sets PORT automatically)
# PORT=3000

# Optional Ridey AI (flat page editor)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=1500
# OPENAI_TEMPERATURE=0.2
# RIDEY_ENABLED=false
# RIDEY_VERSION=1.0
# RIDEY_STRICT_VALIDATION=false
# RIDEY_RATE_LIMIT_PER_HOUR=20
# RIDEY_PERSONA=

# VIDEO_TRANSCODE_ENABLED=false
# VIDEO_TRANSCODE_ADMIN_ONLY=true
# VIDEO_SCENE_SERVER_UPLOAD=false
# VIDEO_EXPORT_URL_MODE=false
#
# .mov (QuickTime) uploads are accepted for videos / 360-videos and always converted to MP4
# via the same FFmpeg path used for compression (requires FFmpeg; rejects if unavailable).
#
# Render blueprint (render.yaml) production defaults:
#   VIDEO_TRANSCODE_ENABLED=true
#   VIDEO_TRANSCODE_ADMIN_ONLY=false
#   VIDEO_SCENE_SERVER_UPLOAD=true
#   VIDEO_EXPORT_URL_MODE=true

# Optional Google Analytics (GA4) — set on Render, not in git
# GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX
# GOOGLE_ANALYTICS_ALLOW_LOCALHOST=false
#
# Admin → Usage: pull GA4 reports (Data API). Needs a service account Viewer on the property.
# GA4_PROPERTY_ID=123456789
# Paste the full JSON key as one line, or base64-encode it:
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GA4_SERVICE_ACCOUNT_FILE=./secrets/ga4-service-account.json
